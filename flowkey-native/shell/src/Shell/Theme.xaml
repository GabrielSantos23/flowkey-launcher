<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <FontFamily x:Key="AppFontFamily">
    pack://application:,,,/Assets/Fonts/Inter-Regular.ttf#Inter;
    pack://application:,,,/Assets/Fonts/Inter-Medium.ttf#Inter Medium;
    pack://application:,,,/Assets/Fonts/Inter-SemiBold.ttf#Inter SemiBold,
    Segoe UI Variable Display, Segoe UI
  </FontFamily>
  <FontFamily x:Key="GlyphFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Color x:Key="WindowBackgroundColor">#1F1F1F</Color>
  <Color x:Key="AccentColor">#4F8CFF</Color>
  <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
  <Color x:Key="TextTertiaryColor">#797979</Color>
  <Color x:Key="KeycapBackgroundColor">#353535</Color>
  <Color x:Key="KeycapBorderColor">#4B4B4B</Color>

  <Color x:Key="ChromeBackgroundColor">#2A2A2A</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="{StaticResource ChromeBackgroundColor}" />
  <SolidColorBrush x:Key="RowSelectedBackgroundBrush" Color="#363636" />
  <SolidColorBrush x:Key="RowBackgroundBrush" Color="Transparent" />
  <SolidColorBrush x:Key="DividerBrush" Color="#363636" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#797979" />
  <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="{StaticResource KeycapBackgroundColor}" />
  <SolidColorBrush x:Key="EnterKeycapBackgroundBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="KeycapBorderBrush" Color="{StaticResource KeycapBorderColor}" />
  <SolidColorBrush x:Key="PaneLabelBrush" Color="#6B7A99" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="SpotifyBrandBrush" Color="#1DB954" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#262626" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#161616" />
  <SolidColorBrush x:Key="CellBackgroundBrush" Color="#2A2A2C" />
  <SolidColorBrush x:Key="CellSelectedOutlineBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ActionPanelBackgroundBrush" Color="#1E1E1E" />

  <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="RowCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="KeycapCornerRadius">5</CornerRadius>
  <CornerRadius x:Key="CellCornerRadius">10</CornerRadius>

  <sys:Double x:Key="SearchFontSize">16</sys:Double>
  <sys:Double x:Key="TitleFontSize">14</sys:Double>
  <sys:Double x:Key="SecondaryFontSize">14</sys:Double>
  <sys:Double x:Key="KindFontSize">13</sys:Double>
  <sys:Double x:Key="HeaderFontSize">12</sys:Double>
  <sys:Double x:Key="FooterFontSize">13</sys:Double>
  <sys:Double x:Key="KeycapFontSize">11</sys:Double>
  <sys:Double x:Key="EmptyTitleFontSize">16</sys:Double>
  <sys:Double x:Key="EmptyDescriptionFontSize">13</sys:Double>
  <sys:Double x:Key="GlyphFontSize">12</sys:Double>
  <sys:Double x:Key="EmojiFontSize">16</sys:Double>
  <sys:Double x:Key="CellEmojiFontSize">26</sys:Double>
  <sys:Double x:Key="CommandIconSize">18</sys:Double>
  <sys:Double x:Key="IconTileSize">28</sys:Double>
  <sys:Double x:Key="IconTileIconSize">16</sys:Double>
  <CornerRadius x:Key="IconTileCornerRadius">6</CornerRadius>
  <SolidColorBrush x:Key="TileBorderBrush" Color="#333333" />
  <sys:Double x:Key="TitleMaxWidth">420</sys:Double>

  <sys:Double x:Key="SearchBarHeight">64</sys:Double>
  <sys:Double x:Key="FooterHeight">40</sys:Double>
  <sys:Double x:Key="RowMinHeight">40</sys:Double>
  <sys:Double x:Key="RowIconSize">20</sys:Double>
  <sys:Double x:Key="FooterIconSize">16</sys:Double>
  <sys:Double x:Key="FooterDividerHeight">16</sys:Double>
  <sys:Double x:Key="BackButtonSize">32</sys:Double>
  <sys:Double x:Key="CellWidth">62</sys:Double>
  <sys:Double x:Key="CellHeight">56</sys:Double>
  <sys:Double x:Key="CellIconSize">34</sys:Double>

  <Thickness x:Key="RowPadding">12,0</Thickness>
  <Thickness x:Key="HeaderMargin">4,10,0,4</Thickness>
  <Thickness x:Key="IconMargin">0,0,10,0</Thickness>
  <Thickness x:Key="TitleSubtitleMargin">8,0,8,0</Thickness>
  <Thickness x:Key="ListInset">8</Thickness>
  <Thickness x:Key="SearchBarPadding">16,0,16,0</Thickness>
  <Thickness x:Key="DropdownPadding">10,2,8,2</Thickness>
  <sys:Double x:Key="DropdownMinWidth">150</sys:Double>
  <Thickness x:Key="BackButtonMargin">12,0,4,0</Thickness>
  <Thickness x:Key="DetailMargin">0,0,0,6</Thickness>
  <Thickness x:Key="CellMargin">1</Thickness>
  <Thickness x:Key="EmptyDescriptionMargin">0,4,0,0</Thickness>
  <Thickness x:Key="FooterLeftPadding">16,0,0,0</Thickness>
  <Thickness x:Key="FooterRightPadding">0,0,16,0</Thickness>
  <Thickness x:Key="KeycapPadding">6,2</Thickness>
  <Thickness x:Key="KeycapMargin">8,0,0,0</Thickness>
  <Thickness x:Key="KeycapSpacing">0,0,4,0</Thickness>
  <Thickness x:Key="FooterDividerMargin">12,0,12,0</Thickness>
  <Thickness x:Key="ActionsLabelMargin">0,0,6,0</Thickness>
  <sys:Double x:Key="PanelRowMinHeight">28</sys:Double>
  <Thickness x:Key="PanelRowPadding">10,4</Thickness>
  <sys:Double x:Key="FilterOptionMinHeight">26</sys:Double>
  <Thickness x:Key="FilterOptionPadding">10,4</Thickness>

  <CornerRadius x:Key="BackButtonCornerRadius">16</CornerRadius>

  <!-- Settings window chrome + sidebar (Phase E, measured against design-reference/raycast-settings-ref) -->
  <GridLength x:Key="SidebarWidth">230</GridLength>
  <sys:Double x:Key="SettingsWindowWidth">1080</sys:Double>
  <sys:Double x:Key="SettingsWindowHeight">700</sys:Double>
  <Thickness x:Key="ChromeResizeBorderThickness">7</Thickness>
  <SolidColorBrush x:Key="ChromeDividerBrush" Color="#3F3F3F" />
  <SolidColorBrush x:Key="ChromeNavDisabledBrush" Color="#484848" />
  <sys:Double x:Key="ChromeWindowButtonWidth">46</sys:Double>
  <sys:Double x:Key="ChromeNavButtonWidth">22</sys:Double>
  <sys:Double x:Key="ChromeGlyphFontSize">10</sys:Double>
  <sys:Double x:Key="ChromeNavGlyphSize">16</sys:Double>
  <Thickness x:Key="ChromeTitleMargin">16,0,0,0</Thickness>
  <Thickness x:Key="ChromeNavClusterMargin">11,0,0,0</Thickness>
  <Thickness x:Key="SidebarPadding">10,16,10,10</Thickness>
  <Thickness x:Key="SidebarSearchPadding">10,4</Thickness>
  <Thickness x:Key="SidebarSearchMargin">0,0,0,20</Thickness>
  <sys:Double x:Key="SearchIconSize">16</sys:Double>
  <Thickness x:Key="NavRowPadding">6,5</Thickness>
  <sys:Double x:Key="NavRowSpacing">2</sys:Double>
  <sys:Double x:Key="NavGroupGap">14</sys:Double>
  <sys:Double x:Key="NavIconGap">8</sys:Double>
  <sys:Double x:Key="SettingsNavIconSize">22</sys:Double>
  <sys:Double x:Key="SettingsNavGlyphSize">14</sys:Double>
  <CornerRadius x:Key="SettingsNavRowCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="SettingsNavTileCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="SettingsSearchCornerRadius">4</CornerRadius>
  <SolidColorBrush x:Key="SettingsNavTileStrokeBrush" Color="#686868" />

  <LinearGradientBrush x:Key="FooterToastErrorBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#96462323" Offset="0" />
    <GradientStop Color="#59462323" Offset="0.45" />
    <GradientStop Color="#00462323" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="FooterToastDotBrush" Color="#FF5C5C" />

  <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#4A4A4A" />
  <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#545454" />
  <SolidColorBrush x:Key="ScrollbarThumbPressedBrush" Color="#646464" />
  <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="#1F1F1F" />

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Focusable="False" Background="{StaticResource ScrollbarThumbBrush}">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" CornerRadius="5" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollbarThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollbarThumbPressedBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Focusable="False" Background="{StaticResource ScrollbarThumbBrush}">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" CornerRadius="5" />
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollbarThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                              <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollbarThumbPressedBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
