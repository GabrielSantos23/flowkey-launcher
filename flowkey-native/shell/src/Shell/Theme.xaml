<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <FontFamily x:Key="AppFontFamily">
    pack://application:,,,/Assets/Fonts/Inter-Regular.ttf#Inter;
    pack://application:,,,/Assets/Fonts/Inter-Medium.ttf#Inter Medium;
    pack://application:,,,/Assets/Fonts/Inter-SemiBold.ttf#Inter SemiBold,
    Segoe UI Variable Display, Segoe UI
  </FontFamily>
  <FontFamily x:Key="GlyphFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="RowSelectedBackgroundBrush" Color="#363636" />
  <SolidColorBrush x:Key="RowBackgroundBrush" Color="Transparent" />
  <SolidColorBrush x:Key="DividerBrush" Color="#363636" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#797979" />
  <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="#353535" />
  <SolidColorBrush x:Key="EnterKeycapBackgroundBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="KeycapBorderBrush" Color="#4B4B4B" />
  <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#262626" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#161616" />
  <SolidColorBrush x:Key="CellBackgroundBrush" Color="#2A2A2C" />
  <SolidColorBrush x:Key="CellSelectedOutlineBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ActionPanelBackgroundBrush" Color="#F0222230" />

  <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="RowCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="KeycapCornerRadius">5</CornerRadius>
  <CornerRadius x:Key="CellCornerRadius">10</CornerRadius>

  <sys:Double x:Key="SearchFontSize">16</sys:Double>
  <sys:Double x:Key="TitleFontSize">14</sys:Double>
  <sys:Double x:Key="SecondaryFontSize">14</sys:Double>
  <sys:Double x:Key="KindFontSize">13</sys:Double>
  <sys:Double x:Key="HeaderFontSize">12</sys:Double>
  <sys:Double x:Key="FooterFontSize">13</sys:Double>
  <sys:Double x:Key="KeycapFontSize">11</sys:Double>
  <sys:Double x:Key="EmptyTitleFontSize">16</sys:Double>
  <sys:Double x:Key="EmptyDescriptionFontSize">13</sys:Double>
  <sys:Double x:Key="GlyphFontSize">12</sys:Double>
  <sys:Double x:Key="EmojiFontSize">16</sys:Double>
  <sys:Double x:Key="CellEmojiFontSize">26</sys:Double>
  <sys:Double x:Key="CommandIconSize">18</sys:Double>

  <sys:Double x:Key="SearchBarHeight">64</sys:Double>
  <sys:Double x:Key="FooterHeight">40</sys:Double>
  <sys:Double x:Key="RowMinHeight">32</sys:Double>
  <sys:Double x:Key="RowSelectedHeight">40</sys:Double>
  <sys:Double x:Key="RowIconSize">20</sys:Double>
  <sys:Double x:Key="FooterIconSize">16</sys:Double>
  <sys:Double x:Key="FooterDividerHeight">16</sys:Double>
  <sys:Double x:Key="BackButtonSize">32</sys:Double>
  <sys:Double x:Key="CellWidth">62</sys:Double>
  <sys:Double x:Key="CellHeight">56</sys:Double>
  <sys:Double x:Key="CellIconSize">34</sys:Double>

  <Thickness x:Key="RowPadding">12,0</Thickness>
  <Thickness x:Key="HeaderMargin">4,10,0,4</Thickness>
  <Thickness x:Key="IconMargin">0,0,10,0</Thickness>
  <Thickness x:Key="TitleSubtitleMargin">8,0,8,0</Thickness>
  <Thickness x:Key="ListInset">8</Thickness>
  <Thickness x:Key="SearchBarPadding">16,0,16,0</Thickness>
  <Thickness x:Key="BackButtonMargin">12,0,4,0</Thickness>
  <Thickness x:Key="DetailMargin">0,0,0,6</Thickness>
  <Thickness x:Key="CellMargin">1</Thickness>
  <Thickness x:Key="EmptyDescriptionMargin">0,4,0,0</Thickness>
  <Thickness x:Key="FooterLeftPadding">16,0,0,0</Thickness>
  <Thickness x:Key="FooterRightPadding">0,0,16,0</Thickness>
  <Thickness x:Key="KeycapPadding">6,2</Thickness>
  <Thickness x:Key="KeycapMargin">8,0,0,0</Thickness>
  <Thickness x:Key="KeycapSpacing">0,0,4,0</Thickness>
  <Thickness x:Key="FooterDividerMargin">12,0,12,0</Thickness>
  <Thickness x:Key="ActionsLabelMargin">0,0,6,0</Thickness>
  <Thickness x:Key="ToastHostMargin">16,0,16,16</Thickness>
  <Thickness x:Key="ToastItemMargin">0,4,0,0</Thickness>
  <Thickness x:Key="ToastPadding">12,8,12,8</Thickness>

  <CornerRadius x:Key="BackButtonCornerRadius">16</CornerRadius>
</ResourceDictionary>
