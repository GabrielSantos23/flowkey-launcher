<Window x:Class="FlowKey.Shell.Windows.ActionPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:FlowKey.Shell.Windows"
        Title="Actions"
        Width="310" SizeToContent="Height"
        MaxHeight="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{DynamicResource AppFontFamily}"
        PreviewKeyDown="OnPanelPreviewKeyDown"
        Deactivated="OnDeactivated">
  <!-- Same rounding as the floating footer pills, so the floating chrome matches. -->
  <Border CornerRadius="{DynamicResource FooterPillCornerRadius}"
          BorderThickness="1"
          BorderBrush="{DynamicResource KeycapBorderBrush}"
          Background="{DynamicResource ActionPanelBackgroundBrush}"
          Margin="6">
    <!-- A Grid (not a StackPanel) so the list row is height-constrained when
         MaxHeight clamps the window: a StackPanel measures the ListBox with
         infinite height, its ScrollViewer never engages and long action lists
         cannot scroll. -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0"
                 x:Name="PanelTitle"
                 FontSize="{DynamicResource HeaderFontSize}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Margin="12,8,12,4" />
      <ListBox Grid.Row="1"
               x:Name="ActionsList"
               Background="Transparent"
               BorderThickness="0"
               Padding="6,2,6,2"
               Foreground="{DynamicResource TextPrimaryBrush}"
               MouseDoubleClick="OnDoubleClick"
               PreviewMouseLeftButtonDown="OnPreviewMouseDown">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="{DynamicResource PanelRowMinHeight}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RowCornerRadius}" Padding="{DynamicResource PanelRowPadding}">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackgroundBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.Resources>
          <DataTemplate DataType="{x:Type windows:PanelHeaderRow}">
            <TextBlock Text="{Binding Title}"
                       FontSize="{DynamicResource HeaderFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Margin="0,8,0,2" />
          </DataTemplate>
        </ListBox.Resources>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Path Grid.Column="0"
                    Data="{Binding Icon}"
                    Stroke="{Binding IconBrush}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Width="{DynamicResource CommandIconSize}"
                    Height="{DynamicResource CommandIconSize}"
                    Stretch="Uniform"
                    VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Action.Title}"
                         FontSize="{DynamicResource TitleFontSize}"
                         Foreground="{Binding TitleBrush}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <ItemsControl Grid.Column="2"
                            ItemsSource="{Binding ShortcutChips}"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            Visibility="{Binding ShortcutVisibility}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource EnterKeycapBackgroundBrush}"
                            BorderBrush="{DynamicResource KeycapBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource KeycapCornerRadius}"
                            Padding="{DynamicResource KeycapPadding}"
                            Margin="3,0,0,0">
                      <TextBlock Text="{Binding}"
                                 FontSize="{DynamicResource KeycapFontSize}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Grid.Column="3"
                      Background="{DynamicResource EnterKeycapBackgroundBrush}"
                      BorderBrush="{DynamicResource KeycapBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource KeycapCornerRadius}"
                      Padding="{DynamicResource KeycapPadding}"
                      VerticalAlignment="Center"
                      Visibility="{Binding EnterKeycapVisibility}">
                <TextBlock FontSize="{DynamicResource KeycapFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" Text="&#x21B5;" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="2"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="8,4,8,0">
        <Grid Margin="6,0,6,0">
          <TextBox x:Name="FilterBox"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource SecondaryFontSize}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Background="Transparent"
                   BorderThickness="0"
                   CaretBrush="{DynamicResource TextPrimaryBrush}"
                   Margin="0,8,0,10"
                   TextChanged="OnFilterTextChanged" />
          <TextBlock x:Name="FilterPlaceholder"
                     Text="Search for actions…"
                     FontSize="{DynamicResource SecondaryFontSize}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,0,2"
                     IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
