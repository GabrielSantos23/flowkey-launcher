<Window x:Class="FlowKey.Shell.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowKey Settings"
        Width="640" Height="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeycapBorderBrush}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,2,0,8" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Margin" Value="0,2,0,8" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,4,8,8" />
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18,14,18,14">
      <TextBlock Text="Summon hotkey" FontSize="{DynamicResource SecondaryFontSize}" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="OnHotkeyPreviewKeyDown" GotKeyboardFocus="OnHotkeyGotFocus" LostKeyboardFocus="OnHotkeyLostFocus" Text="…" />
      <TextBlock x:Name="HotkeyHint" FontSize="{DynamicResource KeycapFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Click the box and press a combination (Ctrl, Alt or Win required)." Margin="0,0,0,12" />

      <CheckBox x:Name="LaunchAtLogin" Content="Start FlowKey when I log in" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,12" Checked="OnLaunchAtLoginChanged" Unchecked="OnLaunchAtLoginChanged" />

      <TextBlock Text="Extensions" FontSize="{DynamicResource SecondaryFontSize}" FontWeight="SemiBold" Margin="0,8,0,6" />
      <StackPanel x:Name="ExtensionsPanel" />

      <TextBlock Text="Maintenance" FontSize="{DynamicResource SecondaryFontSize}" FontWeight="SemiBold" Margin="0,14,0,6" />
      <Button Content="Clear clipboard history" Click="OnClearClipboardHistory" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</Window>
