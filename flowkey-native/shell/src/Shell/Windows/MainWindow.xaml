<Window x:Class="FlowKey.Shell.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rows="clr-namespace:FlowKey.Shell.Sidecar"
        xmlns:rendering="clr-namespace:FlowKey.Shell.Rendering"
        xmlns:calc="clr-namespace:FlowKey.Shell.Search.Calculator"
        Title="FlowKey"
        Width="750" Height="475"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Visibility="Hidden"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded">
  <Window.Resources>
    <Style x:Key="KeycapStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource KeycapBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeycapBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource KeycapCornerRadius}" />
      <Setter Property="Padding" Value="{DynamicResource KeycapPadding}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KeycapText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource KeycapFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <rendering:IconTileBackgroundConverter x:Key="IconTileBackground" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Height="{DynamicResource SearchBarHeight}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Canvas x:Name="LoadingBarHost" Grid.Column="0" Grid.ColumnSpan="3" Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
          <Rectangle x:Name="LoadingBarSegment" Canvas.Bottom="0" Height="3" Width="170" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF">
            <Rectangle.RenderTransform>
              <TranslateTransform x:Name="LoadingBarTranslate" X="-180" />
            </Rectangle.RenderTransform>
          </Rectangle>
        </Canvas>
        <Border x:Name="BackButton"
                Grid.Column="0"
                Width="{DynamicResource BackButtonSize}"
                Height="{DynamicResource BackButtonSize}"
                CornerRadius="{DynamicResource BackButtonCornerRadius}"
                Background="{DynamicResource RowSelectedBackgroundBrush}"
                Margin="{DynamicResource BackButtonMargin}"
                Visibility="Collapsed"
                MouseLeftButtonDown="OnBackButtonClick">
          <TextBlock Text="&#xE72B;"
                     FontFamily="{DynamicResource GlyphFontFamily}"
                     FontSize="{DynamicResource GlyphFontSize}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Column="1" Margin="{DynamicResource SearchBarPadding}">
          <TextBox x:Name="SearchBox"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource SearchFontSize}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Background="Transparent"
                   BorderThickness="0"
                   CaretBrush="{DynamicResource TextPrimaryBrush}"
                   TextChanged="OnSearchTextChanged" />
          <TextBlock x:Name="SearchPlaceholder"
                     Text="Type to search…"
                     FontSize="{DynamicResource SearchFontSize}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <Grid x:Name="FilterDropdown" Grid.Column="2" Visibility="Collapsed" Margin="{DynamicResource SearchBarPadding}">
          <Border x:Name="FilterButton"
                  Background="Transparent"
                  BorderBrush="{DynamicResource KeycapBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource KeycapCornerRadius}"
                  Padding="{DynamicResource DropdownPadding}"
                  MinWidth="{DynamicResource DropdownMinWidth}"
                  VerticalAlignment="Center"
                  MouseLeftButtonUp="OnFilterButtonClick">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FilterLabel"
                         Grid.Column="0"
                         FontSize="{DynamicResource SecondaryFontSize}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Text="&#xE70D;"
                         Grid.Column="1"
                         FontFamily="{DynamicResource GlyphFontFamily}"
                         FontSize="{DynamicResource GlyphFontSize}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
          </Border>
          <Popup x:Name="FilterPopup"
                 PlacementTarget="{Binding ElementName=FilterButton}"
                 Placement="Bottom"
                 StaysOpen="False"
                 AllowsTransparency="True">
            <Border Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource KeycapBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RowCornerRadius}"
                    Margin="6" MinWidth="190">
              <ListBox x:Name="FilterList"
                       BorderThickness="0"
                       Background="Transparent"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       SelectionChanged="OnFilterListSelectionChanged"
                       PreviewMouseLeftButtonDown="OnFilterListClick">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="{DynamicResource FilterOptionPadding}" />
                    <Setter Property="MinHeight" Value="{DynamicResource FilterOptionMinHeight}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource KeycapCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackgroundBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource SecondaryFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Popup>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ListColumn" Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="PaneColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="ResultsList"
             Grid.Column="0"
             Margin="{DynamicResource ListInset}"
             rendering:SmoothScroll.Enabled="True"
             Background="Transparent"
             BorderThickness="0"
             Foreground="{DynamicResource TextPrimaryBrush}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             SelectionMode="Single"
             SelectionChanged="OnSelectionChanged"
             MouseDoubleClick="OnListDoubleClick"
             Visibility="Collapsed">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="MinHeight" Value="{DynamicResource RowMinHeight}" />
          <Setter Property="Background" Value="{DynamicResource RowBackgroundBrush}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RowCornerRadius}" Padding="{DynamicResource RowPadding}">
                  <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackgroundBrush}" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackgroundBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
              <Setter Property="Focusable" Value="False" />
              <Setter Property="IsHitTestVisible" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.Resources>
        <DataTemplate DataType="{x:Type rows:HeaderRow}">
          <TextBlock Text="{Binding Title}"
                     FontSize="{DynamicResource HeaderFontSize}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="{DynamicResource HeaderMargin}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type rows:ItemRow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="{DynamicResource IconTileSize}"
                    Height="{DynamicResource IconTileSize}"
                    Background="{Binding Item.IconColor, Converter={StaticResource IconTileBackground}}"
                    BorderBrush="{DynamicResource TileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource IconTileCornerRadius}"
                    Margin="{DynamicResource IconMargin}"
                    VerticalAlignment="Center">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Item.Icon}" Value="{x:Null}" />
                        <Condition Binding="{Binding Bitmap}" Value="{x:Null}" />
                        <Condition Binding="{Binding VectorIcon}" Value="{x:Null}" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Collapsed" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid Width="{DynamicResource IconTileIconSize}" Height="{DynamicResource IconTileIconSize}">
                <TextBlock Text="{Binding Item.Icon}" FontSize="{DynamicResource EmojiFontSize}" TextAlignment="Center" />
                <Image Source="{Binding Bitmap}" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <Image.Style>
                    <Style TargetType="Image">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Bitmap}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Image.Style>
                </Image>
                <Path Data="{Binding VectorIcon}"
                      Width="{DynamicResource CommandIconSize}"
                      Height="{DynamicResource CommandIconSize}"
                      Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Setter Property="Stroke" Value="{Binding VectorIconBrush}" />
                      <Setter Property="Fill" Value="Transparent" />
                      <Setter Property="StrokeThickness" Value="2" />
                      <Setter Property="StrokeStartLineCap" Value="Round" />
                      <Setter Property="StrokeEndLineCap" Value="Round" />
                      <Setter Property="StrokeLineJoin" Value="Round" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding VectorIconFilled}" Value="True">
                          <Setter Property="Fill" Value="{Binding VectorIconBrush}" />
                          <Setter Property="Stroke" Value="Transparent" />
                          <Setter Property="StrokeThickness" Value="0" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Grid>
            </Border>
            <Grid Grid.Column="1" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding Item.Title}"
                         FontSize="{DynamicResource TitleFontSize}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         MaxWidth="{DynamicResource TitleMaxWidth}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Item.Subtitle}"
                         FontSize="{DynamicResource SecondaryFontSize}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="{DynamicResource TitleSubtitleMargin}"
                         TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Item.Subtitle}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Item.Subtitle}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <TextBlock Grid.Column="2"
                       Text="{Binding Item.Kind}"
                       FontSize="{DynamicResource KindFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Item.Kind}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Item.Kind}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calc:CalculatorRow}">
          <Border Background="{DynamicResource SurfaceBrush}"
                  CornerRadius="10"
                  Padding="0,16"
                  Margin="8,2,8,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Expression}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="280"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Border HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        CornerRadius="4"
                        Padding="8,3"
                        Background="{DynamicResource KeycapBackgroundBrush}">
                  <TextBlock Text="{Binding ExpressionBadge}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
              </StackPanel>
              <Grid Grid.Column="1" VerticalAlignment="Center">
                <Rectangle Width="1" Height="44" HorizontalAlignment="Center" Fill="{DynamicResource DividerBrush}" />
                <TextBlock Text="&#x2192;"
                           FontSize="18"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Padding="7,0"
                           Background="{DynamicResource SurfaceBrush}" />
              </Grid>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding Result}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="280"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Border HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        CornerRadius="4"
                        Padding="8,3"
                        Background="{DynamicResource KeycapBackgroundBrush}">
                  <TextBlock Text="{Binding ResultBadge}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.Resources>
    </ListBox>

      <Border x:Name="PaneDivider" Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Visibility="Collapsed" />
      <Grid x:Name="PaneHost" Grid.Column="2" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" rendering:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="PanePreview" Margin="14,10,14,10" />
        </ScrollViewer>
        <StackPanel x:Name="PaneInfo" Grid.Row="1" Margin="14,0,14,10" />
      </Grid>
    </Grid>

    <ScrollViewer x:Name="DetailHost"
             Grid.Row="1"
             rendering:SmoothScroll.Enabled="True"
             Margin="{DynamicResource DetailMargin}"
             VerticalScrollBarVisibility="Auto"
             Visibility="Collapsed" />

    <DockPanel x:Name="GridHostPanel"
             Grid.Row="1"
             Background="Transparent"
             Visibility="Collapsed">
      <TextBlock x:Name="GridTitleText"
                 DockPanel.Dock="Top"
                 FontSize="{DynamicResource HeaderFontSize}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Margin="{DynamicResource HeaderMargin}"
                 Visibility="Collapsed" />
      <ListBox x:Name="GridHost"
             rendering:SmoothScroll.Enabled="True"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding Cells}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="{Binding CellSize}" Margin="{DynamicResource CellMargin}">
                    <Border Width="{Binding CellSize}" Height="{Binding CellSize}" CornerRadius="{DynamicResource CellCornerRadius}"
                            Background="{Binding CellBackground}"
                            BorderBrush="{Binding OutlineBrush}"
                            BorderThickness="{Binding OutlineThickness}"
                            ClipToBounds="True"
                            Tag="{Binding FlatIndex}"
                            MouseLeftButtonDown="OnGridCellClick">
                      <Grid>
                        <Image Source="{Binding Bitmap}" Width="{Binding ImageDisplaySize}" Height="{Binding ImageDisplaySize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Item.Icon}" FontSize="{Binding GlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding BitmapFallback}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <StackPanel x:Name="EmptyView"
                Grid.Row="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="Collapsed">
      <TextBlock x:Name="EmptyTitle" FontSize="{DynamicResource EmptyTitleFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" />
      <TextBlock x:Name="EmptyDescription" FontSize="{DynamicResource EmptyDescriptionFontSize}" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center" Margin="{DynamicResource EmptyDescriptionMargin}" />
    </StackPanel>

    <Border Grid.Row="2" Height="{DynamicResource FooterHeight}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="FooterLeft" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="{DynamicResource FooterLeftPadding}" />
        <StackPanel x:Name="FooterRight" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource FooterRightPadding}">
          <TextBlock x:Name="FooterPrimaryAction"
                     FontSize="{DynamicResource FooterFontSize}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center" />
          <Border x:Name="FooterEnterKeycap"
                  Style="{StaticResource KeycapStyle}"
                  Background="{DynamicResource EnterKeycapBackgroundBrush}"
                  Margin="{DynamicResource KeycapMargin}">
            <TextBlock Style="{StaticResource KeycapText}" Text="&#x21B5;" />
          </Border>
          <Border Width="1" Height="{DynamicResource FooterDividerHeight}" Background="{DynamicResource KeycapBorderBrush}" Margin="{DynamicResource FooterDividerMargin}" VerticalAlignment="Center" />
          <TextBlock Text="Actions"
                     FontSize="{DynamicResource FooterFontSize}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     VerticalAlignment="Center" Margin="{DynamicResource ActionsLabelMargin}" />
          <Border Style="{StaticResource KeycapStyle}" Margin="{DynamicResource KeycapSpacing}">
            <TextBlock Style="{StaticResource KeycapText}" Text="Ctrl" />
          </Border>
          <Border Style="{StaticResource KeycapStyle}">
            <TextBlock Style="{StaticResource KeycapText}" Text="K" />
          </Border>
        </StackPanel>
        <Border x:Name="FooterToastHost"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                IsHitTestVisible="False"
                Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0" MaxWidth="470">
            <Ellipse x:Name="FooterToastDot"
                     Width="7"
                     Height="7"
                     Fill="{StaticResource FooterToastDotBrush}"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="FooterToastTitle"
                       Margin="9,0,0,0"
                       FontSize="{DynamicResource FooterFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FooterToastDetail"
                       Margin="8,0,0,0"
                       FontSize="{DynamicResource FooterFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>


  </Grid>
</Window>
