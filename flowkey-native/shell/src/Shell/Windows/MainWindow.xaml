<Window x:Class="FlowKey.Shell.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rows="clr-namespace:FlowKey.Shell.Sidecar"
        Title="FlowKey"
        Width="720" Height="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Visibility="Hidden"
        Deactivated="OnDeactivated"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#F01E1E28" />
    <SolidColorBrush x:Key="BorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E6EF" />
    <SolidColorBrush x:Key="DimTextBrush" Color="#8A8A9A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#2E3A50" />
  </Window.Resources>
  <Border CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource PanelBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="16,14,16,10">
        <TextBox x:Name="SearchBox"
                 FontSize="18"
                 Foreground="{StaticResource TextBrush}"
                 Background="Transparent"
                 BorderThickness="0,0,0,1"
                 BorderBrush="{StaticResource BorderBrush}"
                 CaretBrush="{StaticResource AccentBrush}"
                 TextChanged="OnSearchTextChanged"
                 KeyDown="OnSearchKeyDown" />
      </Border>

      <ListBox x:Name="ResultsList"
               Grid.Row="1"
               Margin="6,0,6,6"
               Background="Transparent"
               BorderThickness="0"
               Foreground="{StaticResource TextBrush}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.CanContentScroll="True"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               SelectionMode="Single"
               SelectionChanged="OnSelectionChanged"
               MouseDoubleClick="OnListDoubleClick"
               KeyDown="OnListKeyDown"
               Visibility="Collapsed">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.Resources>
          <DataTemplate DataType="{x:Type rows:HeaderRow}">
            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimTextBrush}" Margin="10,10,0,2" />
          </DataTemplate>
          <DataTemplate DataType="{x:Type rows:ItemRow}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Item.Icon}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Item.Title}" FontSize="14" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Item.Subtitle}" FontSize="11" Foreground="{StaticResource DimTextBrush}" TextTrimming="CharacterEllipsis">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Item.Subtitle}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Item.Subtitle}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.Resources>
      </ListBox>

      <StackPanel x:Name="EmptyView"
                  Grid.Row="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Visibility="Collapsed">
        <TextBlock x:Name="EmptyTitle" FontSize="16" Foreground="{StaticResource DimTextBrush}" TextAlignment="Center" />
        <TextBlock x:Name="EmptyDescription" FontSize="13" Foreground="{StaticResource DimTextBrush}" TextAlignment="Center" Margin="0,4,0,0" />
      </StackPanel>

      <Border Grid.Row="2" Padding="16,8,16,12">
        <TextBlock x:Name="StatusBar" FontSize="11" Foreground="{StaticResource DimTextBrush}" Text="" />
      </Border>

      <StackPanel x:Name="ToastHost"
                  Grid.Row="0"
                  Grid.RowSpan="3"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Stretch"
                  Margin="16,0,16,16" />
    </Grid>
  </Border>
</Window>
