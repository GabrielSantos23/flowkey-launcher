<Window x:Class="FlowKey.Shell.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rows="clr-namespace:FlowKey.Shell.Sidecar"
        xmlns:rendering="clr-namespace:FlowKey.Shell.Rendering"
        Title="FlowKey"
        Width="750" Height="475"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Visibility="Hidden"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        UseLayoutRounding="True"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded">
  <Window.Resources>
    <Style x:Key="KeycapStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource KeycapBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KeycapBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource KeycapCornerRadius}" />
      <Setter Property="Padding" Value="{DynamicResource KeycapPadding}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KeycapText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource KeycapFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <Border Height="{DynamicResource SearchBarHeight}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Canvas x:Name="LoadingBarHost" Grid.Column="0" Grid.ColumnSpan="3" Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
          <Rectangle x:Name="LoadingBarSegment" Canvas.Bottom="0" Height="3" Width="170" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF">
            <Rectangle.RenderTransform>
              <TranslateTransform x:Name="LoadingBarTranslate" X="-180" />
            </Rectangle.RenderTransform>
          </Rectangle>
        </Canvas>
        <Border x:Name="BackButton"
                Grid.Column="0"
                Width="{DynamicResource BackButtonSize}"
                Height="{DynamicResource BackButtonSize}"
                CornerRadius="{DynamicResource BackButtonCornerRadius}"
                Background="{DynamicResource RowSelectedBackgroundBrush}"
                Margin="{DynamicResource BackButtonMargin}"
                Visibility="Collapsed"
                MouseLeftButtonDown="OnBackButtonClick">
          <TextBlock Text="&#xE72B;"
                     FontFamily="{DynamicResource GlyphFontFamily}"
                     FontSize="{DynamicResource GlyphFontSize}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Column="1" Margin="{DynamicResource SearchBarPadding}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image x:Name="SearchBrandIcon"
                 Grid.Column="0"
                 Source="pack://application:,,,/Assets/logo.png"
                 Width="{DynamicResource SearchBrandIconSize}"
                 Height="{DynamicResource SearchBrandIconSize}"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0"
                 IsHitTestVisible="False" />
          <Grid Grid.Column="1" VerticalAlignment="Center">
            <TextBox x:Name="SearchBox"
                     VerticalAlignment="Center"
                     FontSize="{DynamicResource SearchFontSize}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                     TextChanged="OnSearchTextChanged">
              <TextBox.Style>
                <Style TargetType="TextBox">
                  <Setter Property="Template">
                    <Setter.Value>
                      <!-- Chromeless: no theme chrome; the content host is a
                           bare presenter (no themed border or scrollbars). -->
                      <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      BorderThickness="0"
                                      BorderBrush="Transparent"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden">
                          <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="ScrollViewer">
                                    <ScrollContentPresenter />
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style>
                          </ScrollViewer.Style>
                        </ScrollViewer>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </TextBox.Style>
            </TextBox>
            <TextBlock x:Name="SearchPlaceholder"
                       Text="Search for apps and commands…"
                       FontSize="{DynamicResource SearchFontSize}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Grid>
        <Grid x:Name="FilterDropdown" Grid.Column="2" Visibility="Collapsed" Margin="{DynamicResource SearchBarPadding}">
          <Border x:Name="FilterButton"
                  Background="Transparent"
                  BorderBrush="{DynamicResource KeycapBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource KeycapCornerRadius}"
                  Padding="{DynamicResource DropdownPadding}"
                  MinWidth="{DynamicResource DropdownMinWidth}"
                  VerticalAlignment="Center"
                  MouseLeftButtonUp="OnFilterButtonClick">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FilterLabel"
                         Grid.Column="0"
                         FontSize="{DynamicResource SecondaryFontSize}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Text="&#xE70D;"
                         Grid.Column="1"
                         FontFamily="{DynamicResource GlyphFontFamily}"
                         FontSize="{DynamicResource GlyphFontSize}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
          </Border>
          <Popup x:Name="FilterPopup"
                 PlacementTarget="{Binding ElementName=FilterButton}"
                 Placement="Bottom"
                 StaysOpen="False"
                 AllowsTransparency="True">
            <Border Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource KeycapBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RowCornerRadius}"
                    Margin="6" MinWidth="190">
              <ListBox x:Name="FilterList"
                       BorderThickness="0"
                       Background="Transparent"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       MaxHeight="300"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       SelectionChanged="OnFilterListSelectionChanged"
                       PreviewMouseLeftButtonDown="OnFilterListClick">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="{DynamicResource FilterOptionPadding}" />
                    <Setter Property="MinHeight" Value="{DynamicResource FilterOptionMinHeight}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource KeycapCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackgroundBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource SecondaryFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Popup>
        </Grid>
      </Grid>
      </Border>
      <Border x:Name="UpdateBannerHost"
              Margin="{DynamicResource ListInset}"
              Padding="14,10"
              CornerRadius="{DynamicResource RowCornerRadius}"
              Background="{DynamicResource RowSelectedBackgroundBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="1"
              Visibility="Collapsed"
              Cursor="Hand"
              MouseLeftButtonDown="OnUpdateBannerClick">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Width="30"
                  Height="30"
                  CornerRadius="7"
                  Background="#E5484D"
                  VerticalAlignment="Center">
            <TextBlock Text="&#xE896;"
                       FontFamily="{DynamicResource GlyphFontFamily}"
                       FontSize="14"
                       Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
            <TextBlock x:Name="UpdateBannerTitle"
                       Text="New Update Available"
                       FontSize="{DynamicResource TitleFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="UpdateBannerDetail"
                       FontSize="{DynamicResource KindFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
          <TextBlock x:Name="UpdateBannerAction"
                     Grid.Column="2"
                     Text="Install Update"
                     FontSize="{DynamicResource SecondaryFontSize}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>
    <!-- The list spans into the footer row so rows flow behind the floating
         pills; the mask dissolves the content at the window's bottom edge. -->
    <Grid Grid.Row="1"
          Grid.RowSpan="2"
          OpacityMask="{DynamicResource ContentFadeMask}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ListColumn" Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="PaneColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="ResultsList"
             Grid.Column="0"
             Margin="{DynamicResource ListInset}"
             rendering:SmoothScroll.Enabled="True"
             Background="Transparent"
             BorderThickness="0"
             Foreground="{DynamicResource TextPrimaryBrush}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.ScrollUnit="Pixel"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             SelectionMode="Single"
             SelectionChanged="OnSelectionChanged"
             MouseDoubleClick="OnListDoubleClick"
             Visibility="Collapsed">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="MinHeight" Value="{DynamicResource RowMinHeight}" />
          <Setter Property="Background" Value="{DynamicResource RowBackgroundBrush}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RowCornerRadius}" Padding="{DynamicResource RowPadding}">
                  <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackgroundBrush}" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackgroundBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
              <Setter Property="Focusable" Value="False" />
              <Setter Property="IsHitTestVisible" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.Resources>
        <DataTemplate DataType="{x:Type rows:HeaderRow}">
          <TextBlock IsHitTestVisible="False"
                     Text="{Binding Title}"
                     FontSize="{DynamicResource HeaderFontSize}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="{DynamicResource HeaderMargin}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type rows:CalculatorItemRow}">
          <!-- transparent card: the list's selection highlight is the single
               surface, exactly like the Raycast calculator row -->
          <Border Background="Transparent"
                  Padding="0,14"
                  Margin="0,2,0,6">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Item.Subtitle}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="24,0" />
                <TextBlock Grid.Column="1"
                           Text="&#x2192;"
                           FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Item.Title}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="24,0" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource KeycapBackgroundBrush}"
                        CornerRadius="5"
                        Padding="7,2">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Item.Accessories.Count, FallbackValue=0}" Value="2">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Item.Accessories[0].Text, FallbackValue=''}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource KeycapBackgroundBrush}"
                        CornerRadius="5"
                        Padding="7,2">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Item.Accessories.Count, FallbackValue=0}" Value="2">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Item.Accessories[1].Text, FallbackValue=''}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type rows:ItemRow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Icons render bare, Raycast-style: no tile background or border. -->
            <Border Grid.Column="0"
                    Width="{DynamicResource IconTileSize}"
                    Height="{DynamicResource IconTileSize}"
                    Margin="{DynamicResource IconMargin}"
                    VerticalAlignment="Center">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Item.Icon}" Value="{x:Null}" />
                        <Condition Binding="{Binding Bitmap}" Value="{x:Null}" />
                        <Condition Binding="{Binding VectorIcon}" Value="{x:Null}" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Collapsed" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid Width="{DynamicResource IconTileIconSize}" Height="{DynamicResource IconTileIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Item.Icon}" FontSize="{DynamicResource EmojiFontSize}" TextAlignment="Center" />
                <Image Source="{Binding Bitmap}" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <Image.Style>
                    <Style TargetType="Image">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Bitmap}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Image.Style>
                </Image>
                <Path Data="{Binding VectorIcon}"
                      Width="{DynamicResource CommandIconSize}"
                      Height="{DynamicResource CommandIconSize}"
                      Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Setter Property="Stroke" Value="{Binding VectorIconBrush}" />
                      <Setter Property="Fill" Value="Transparent" />
                      <Setter Property="StrokeThickness" Value="2" />
                      <Setter Property="StrokeStartLineCap" Value="Round" />
                      <Setter Property="StrokeEndLineCap" Value="Round" />
                      <Setter Property="StrokeLineJoin" Value="Round" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding VectorIconFilled}" Value="True">
                          <Setter Property="Fill" Value="{Binding VectorIconBrush}" />
                          <Setter Property="Stroke" Value="Transparent" />
                          <Setter Property="StrokeThickness" Value="0" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Grid>
            </Border>
            <Grid Grid.Column="1" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         rendering:MatchHighlight.Row="{Binding}"
                         FontSize="{DynamicResource TitleFontSize}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         MaxWidth="{DynamicResource TitleMaxWidth}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Item.Subtitle}"
                         FontSize="{DynamicResource SecondaryFontSize}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="{DynamicResource TitleSubtitleMargin}"
                         TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Item.Subtitle}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Item.Subtitle}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <TextBlock Grid.Column="2"
                       Text="{Binding Item.Kind}"
                       FontSize="{DynamicResource KindFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Item.Kind}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Item.Kind}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl Grid.Column="3"
                          ItemsSource="{Binding Item.Accessories}"
                          VerticalAlignment="Center"
                          Margin="10,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource ChipBackgroundBrush}"
                          CornerRadius="{DynamicResource KeycapCornerRadius}"
                          Padding="7,2"
                          Margin="6,0,0,0"
                          ToolTip="{Binding Tooltip}">
                    <TextBlock Text="{Binding Text}"
                               FontSize="{DynamicResource KeycapFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Color}" Value="success">
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Color}" Value="danger">
                              <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Color}" Value="accent">
                              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type rows:LoadMoreRow}">
          <Border Padding="0,10">
            <TextBlock Text="Load more"
                       FontSize="{DynamicResource SecondaryFontSize}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="Medium"
                       HorizontalAlignment="Center" />
          </Border>
        </DataTemplate>
      </ListBox.Resources>
    </ListBox>

      <Border x:Name="PaneDivider" Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Visibility="Collapsed" />
      <Grid x:Name="PaneHost" Grid.Column="2" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" rendering:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="PanePreview" Margin="14,10,14,10" />
        </ScrollViewer>
        <StackPanel x:Name="PaneInfo" Grid.Row="1" Margin="14,0,14,10" />
      </Grid>
    </Grid>

    <ScrollViewer x:Name="DetailHost"
             Grid.Row="1"
             Grid.RowSpan="2"
             OpacityMask="{DynamicResource ContentFadeMask}"
             rendering:SmoothScroll.Enabled="True"
             Margin="{DynamicResource DetailMargin}"
             VerticalScrollBarVisibility="Auto"
             Visibility="Collapsed" />
    <Border x:Name="WebViewSurface"
            Grid.Row="1"
            Margin="{DynamicResource DetailMargin}"
            Visibility="Collapsed"
            Background="{DynamicResource WindowBackgroundBrush}">
      <Grid x:Name="WebViewContainer" />
    </Border>

    <DockPanel x:Name="GridHostPanel"
             Grid.Row="1"
             Grid.RowSpan="2"
             OpacityMask="{DynamicResource ContentFadeMask}"
             Background="Transparent"
             Visibility="Collapsed">
      <TextBlock x:Name="GridTitleText"
                 DockPanel.Dock="Top"
                 FontSize="{DynamicResource HeaderFontSize}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Margin="{DynamicResource HeaderMargin}"
                 Visibility="Collapsed" />
      <ListBox x:Name="GridHost"
             rendering:SmoothScroll.Enabled="True"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.ScrollUnit="Pixel"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Resources>
          <DataTemplate DataType="{x:Type rendering:GridHeaderRowVm}">
            <StackPanel Orientation="Horizontal" Margin="4,10,0,6">
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,2,0,0" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="{x:Type rendering:GridRowVm}">
            <ItemsControl ItemsSource="{Binding Cells}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="{Binding CellSize}" Margin="{DynamicResource CellMargin}">
                    <Border Width="{Binding CellSize}" Height="{Binding CellSize}" CornerRadius="{DynamicResource CellCornerRadius}"
                            Background="{Binding CellBackground}"
                            BorderBrush="{Binding OutlineBrush}"
                            BorderThickness="{Binding OutlineThickness}"
                            ClipToBounds="True"
                            Tag="{Binding FlatIndex}"
                            MouseLeftButtonDown="OnGridCellClick">
                      <Grid>
                        <Image Source="{Binding Bitmap}" Width="{Binding ImageDisplaySize}" Height="{Binding ImageDisplaySize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Image.Style>
                            <Style TargetType="Image">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Bitmap}" Value="{x:Null}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding Item.Icon}" FontSize="{Binding GlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding BitmapFallback}" />
                        <Path Data="{Binding VectorIcon}"
                              Width="{Binding IconSize}"
                              Height="{Binding IconSize}"
                              Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Path.Style>
                            <Style TargetType="Path">
                              <Setter Property="Stroke" Value="{Binding VectorIconBrush}" />
                              <Setter Property="Fill" Value="Transparent" />
                              <Setter Property="StrokeThickness" Value="2" />
                              <Setter Property="StrokeStartLineCap" Value="Round" />
                              <Setter Property="StrokeEndLineCap" Value="Round" />
                              <Setter Property="StrokeLineJoin" Value="Round" />
                            </Style>
                          </Path.Style>
                        </Path>
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </DataTemplate>
        </ListBox.Resources>
      </ListBox>
    </DockPanel>

    <StackPanel x:Name="EmptyView"
                Grid.Row="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="Collapsed">
      <TextBlock x:Name="EmptyTitle" FontSize="{DynamicResource EmptyTitleFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" />
      <TextBlock x:Name="EmptyDescription" FontSize="{DynamicResource EmptyDescriptionFontSize}" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center" Margin="{DynamicResource EmptyDescriptionMargin}" />
    </StackPanel>

    <!-- Floating pill footer (no contrast bar): native fallback layout below;
         the WebView-rendered pills live in FooterWebViewContainer. -->
    <Border Grid.Row="2" Height="{DynamicResource FooterHeight}" Background="Transparent" MouseLeftButtonDown="OnFooterDragMove">
      <Grid>
        <Grid x:Name="FooterNativeContent">
          <Border x:Name="FooterLeftPill"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Height="{DynamicResource FooterPillHeight}"
                  CornerRadius="{DynamicResource FooterPillCornerRadius}"
                  Background="{DynamicResource ActionPanelBackgroundBrush}"
                  BorderBrush="{DynamicResource KeycapBorderBrush}"
                  BorderThickness="1"
                  Padding="{DynamicResource FooterPillPadding}"
                  Margin="{DynamicResource FooterPillMargin}">
            <ContentControl x:Name="FooterLeft" VerticalAlignment="Center" HorizontalAlignment="Left" />
          </Border>
          <Border x:Name="FooterRightPill"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Height="{DynamicResource FooterPillHeight}"
                  CornerRadius="{DynamicResource FooterPillCornerRadius}"
                  Background="{DynamicResource ActionPanelBackgroundBrush}"
                  BorderBrush="{DynamicResource KeycapBorderBrush}"
                  BorderThickness="1"
                  Padding="{DynamicResource FooterPillPadding}"
                  Margin="{DynamicResource FooterPillMargin}">
            <StackPanel x:Name="FooterRight" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="FooterPrimaryAction"
                         FontSize="{DynamicResource FooterFontSize}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <Border x:Name="FooterEnterKeycap"
                      Style="{StaticResource KeycapStyle}"
                      Background="{DynamicResource EnterKeycapBackgroundBrush}"
                      Margin="{DynamicResource KeycapMargin}">
                <TextBlock Style="{StaticResource KeycapText}" Text="&#x21B5;" />
              </Border>
              <StackPanel x:Name="FooterActionsHint" Orientation="Horizontal">
                <Border Width="1" Height="{DynamicResource FooterDividerHeight}" Background="{DynamicResource KeycapBorderBrush}" Margin="{DynamicResource FooterDividerMargin}" VerticalAlignment="Center" />
                <TextBlock Text="Actions"
                           FontSize="{DynamicResource FooterFontSize}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="{DynamicResource ActionsLabelMargin}" />
                <Border Style="{StaticResource KeycapStyle}" Margin="{DynamicResource KeycapSpacing}">
                  <TextBlock Style="{StaticResource KeycapText}" Text="Ctrl" />
                </Border>
                <Border Style="{StaticResource KeycapStyle}">
                  <TextBlock Style="{StaticResource KeycapText}" Text="K" />
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="FooterToastHost"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Height="{DynamicResource FooterPillHeight}"
                  CornerRadius="{DynamicResource FooterPillCornerRadius}"
                  Background="{DynamicResource ActionPanelBackgroundBrush}"
                  BorderBrush="{DynamicResource KeycapBorderBrush}"
                  BorderThickness="1"
                  Padding="{DynamicResource FooterPillPadding}"
                  Margin="{DynamicResource FooterPillMargin}"
                  IsHitTestVisible="False"
                  Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="470">
              <Ellipse x:Name="FooterToastDot"
                       Width="7"
                       Height="7"
                       Fill="{StaticResource FooterToastDotBrush}"
                       VerticalAlignment="Center" />
              <TextBlock x:Name="FooterToastTitle"
                         Margin="9,0,0,0"
                         FontSize="{DynamicResource FooterFontSize}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="FooterToastDetail"
                         Margin="8,0,0,0"
                         FontSize="{DynamicResource FooterFontSize}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Grid>
        <!-- WebView-rendered footer pills (same pipeline as web extensions);
             the native pills above stay as the fallback until it reports ready. -->
        <Grid x:Name="FooterWebViewContainer" Visibility="Collapsed" />
      </Grid>
    </Border>


  </Grid>
  </Border>
</Window>
