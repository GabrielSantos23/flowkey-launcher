{
  "$comment": "Shared manifest validation fixture. The bun test in sdk/ and the xunit test in shell/tests/ both validate their manifest validators against these exact cases, so validator drift fails both sides. 'invalid' cases assert at least one error on expectedField with expectedCode.",
  "valid": [
    {
      "name": "minimal",
      "manifest": {
        "id": "hello-world",
        "name": "Hello World",
        "version": "1.0.0",
        "description": "A minimal third-party extension.",
        "icon": "👋",
        "commands": [
          {
            "id": "open",
            "title": "Hello World"
          }
        ],
        "nativeMethods": ["clipboard.write"],
        "httpHosts": []
      }
    },
    {
      "name": "wildcards-and-capabilities",
      "manifest": {
        "id": "capability-demo",
        "name": "Capability Demo",
        "version": "0.2.1-beta.1",
        "description": "Exercises wildcard declarations, suffix hosts, oauth and preferences.",
        "icon": "🧪",
        "entry": "bundle.js",
        "commands": [
          {
            "id": "search-things",
            "title": "Search Things",
            "mode": "view",
            "keywords": ["demo"],
            "icon": "search",
            "iconColor": "#3B82F6",
            "subtitle": "Notes & vaults",
            "disabledByDefault": true,
            "ui": "web",
            "webEntry": "main.web.js"
          },
          {
            "id": "run-job",
            "title": "Run Job",
            "mode": "background"
          },
          {
            "id": "sync",
            "title": "Sync vault",
            "mode": "background",
            "interval": 300,
            "arguments": [
              {
                "name": "direction",
                "type": "dropdown",
                "placeholder": "Direction",
                "required": true,
                "data": [
                  {
                    "title": "Push",
                    "value": "push"
                  },
                  {
                    "title": "Pull",
                    "value": "pull"
                  }
                ]
              }
            ]
          }
        ],
        "nativeMethods": [
          "http.fetch",
          "storage.*",
          "clipboard.write",
          "shell.openUrl",
          "secrets.get",
          "fs.readText",
          "fs.glob",
          "shell.openPath"
        ],
        "httpHosts": ["api.example.com", ".cdn.example.com", "lrclib.net:8443"],
        "oauth": ["spotify"],
        "preferences": [
          {
            "name": "apiKey",
            "type": "password",
            "title": "API key",
            "required": true
          },
          {
            "name": "region",
            "type": "dropdown",
            "title": "Region",
            "default": "eu",
            "options": [
              {
                "value": "eu",
                "title": "Europe"
              },
              {
                "value": "us",
                "title": "US"
              }
            ]
          },
          {
            "name": "showBadges",
            "type": "checkbox",
            "title": "Show badges",
            "default": true
          },
          {
            "name": "greeting",
            "type": "text",
            "title": "Greeting",
            "default": "Hello"
          },
          {
            "name": "vaultFolder",
            "type": "directory",
            "title": "Vault folder",
            "default": "C:/notes"
          },
          {
            "name": "exportFile",
            "type": "file",
            "title": "Export file",
            "placeholder": "Choose a .json file"
          },
          {
            "name": "editorApp",
            "type": "appPicker",
            "title": "Editor application",
            "required": true
          },
          {
            "name": "showHints",
            "type": "checkbox",
            "title": "Show hints",
            "label": "Display hint chips next to results",
            "default": false
          },
          {
            "name": "vaultName",
            "type": "text",
            "title": "Vault name",
            "placeholder": "e.g. Personal"
          }
        ],
        "fsPaths": ["{{vaultPath}}/**/*.md", "C:/shared/notes/**"],
        "uriSchemes": ["obsidian"]
      }
    },
    {
      "name": "no-optional-fields",
      "manifest": {
        "id": "bare.minimum",
        "name": "Bare Minimum",
        "version": "1.0.0",
        "commands": [
          {
            "id": "ping",
            "title": "Ping"
          }
        ],
        "nativeMethods": [],
        "httpHosts": []
      }
    },
    {
      "name": "image-file-icon",
      "manifest": {
        "id": "image-icon-ext",
        "name": "Image Icon Ext",
        "version": "1.0.0",
        "description": "Ships a png as its icon.",
