{
  "protocolVersion": 1,
  "hostToSidecar": {
    "init": {
      "type": "init",
      "protocolVersion": 1,
      "extensionsDir": "C:/app/extensions",
      "preferences": {
        "emoji": {
          "skinTone": "none"
        }
      },
      "disabledExtensions": []
    },
    "search": {
      "type": "search",
      "requestId": "s-1",
      "extensionId": "emoji",
      "query": "part",
      "commandId": null
    },
    "action": {
      "type": "action",
      "requestId": "a-1",
      "extensionId": "emoji",
      "actionId": "copy",
      "item": {
        "id": "🎉",
        "title": "🎉 Party Popper",
        "icon": "🎉",
        "actions": [
          {
            "id": "copy",
            "title": "Copy",
            "primary": true
          }
        ]
      },
      "arguments": {
        "direction": "push"
      }
    },
    "preferences": {
      "type": "preferences",
      "extensionId": "emoji",
      "values": {
        "skinTone": "1F3FD"
      }
    },
    "searchWithCommand": {
      "type": "search",
      "requestId": "s-9",
      "extensionId": "clipboard-history",
      "query": "",
      "commandId": "open",
      "filterValue": "all"
    },
    "nativeResultOk": {
      "type": "nativeResult",
      "requestId": "n-3",
      "ok": true,
      "result": {
        "ok": true,
        "value": {
          "last-sync": "2026-09-27T08:00:00Z"
        }
      }
    },
    "nativeResultError": {
      "type": "nativeResult",
      "requestId": "n-2",
      "ok": false,
      "error": {
        "code": "hostNotAllowed",
        "message": "host evil.example.com is not declared by extension emoji"
      }
    },
    "webCall": {
      "type": "webCall",
      "bridgeId": "w-1",
      "extensionId": "speedtest",
      "method": "http.fetch",
      "timeoutMs": 20000,
      "params": {
        "url": "https://speed.cloudflare.com/__down?bytes=4000000",
        "discardBody": true
      }
    },
    "webAbort": {
      "type": "webAbort",
      "bridgeId": "w-1",
      "extensionId": "speedtest"
    }
  },
  "sidecarToHost": {
    "ready": {
      "type": "ready",
      "protocolVersion": 1,
      "extensions": [
        {
          "id": "emoji",
          "name": "Emoji",
          "version": "1.0.0",
          "commands": [
            {
              "id": "open",
              "title": "Emoji & Symbols",
              "keywords": ["emoji", "symbol", "kaomoji"],
              "mode": "view",
              "icon": "smile",
              "iconColor": "#4F8CFF"
            }
          ],
          "nativeMethods": ["clipboard.write"],
          "httpHosts": [],
          "oauth": [],
          "icon": "😀",
          "preferences": [
            {
              "name": "skinTone",
              "type": "dropdown",
              "title": "Default skin tone",
              "default": "none",
              "options": [
                {
                  "value": "none",
                  "title": "None"
                },
                {
                  "value": "1F3FD",
                  "title": "Medium"
                }
              ]
            }
          ],
          "description": "Fixture extension description."
        }
      ],
      "failures": []
    },
    "readyWithFailures": {
      "type": "ready",
      "protocolVersion": 1,
      "extensions": [],
      "failures": [
        {
          "id": "weather-pro",
          "message": "failed to load: SyntaxError: Unexpected token 'export'"
        }
      ]
    },
    "ui": {
      "type": "ui",
      "requestId": "s-1",
      "tree": {
        "type": "list",
        "sections": [
          {
            "items": [
              {
                "id": "🎉",
                "title": "🎉 Party Popper",
                "subtitle": "celebration, party",
                "icon": "🎉",
                "actions": [
                  {
                    "id": "copy",
                    "title": "Copy",
                    "primary": true
                  },
                  {
                    "id": "open-album",
                    "title": "Go to Songs",
                    "push": "album-songs:al1"
                  }
                ]
              }
            ]
          }
        ],
        "emptyView": {
          "title": "No matches"
        }
      }
    },
    "error": {
      "type": "error",
      "requestId": "a-1",
      "error": {
        "code": "nativeMethodFailed",
        "message": "clipboard.write failed: access denied"
      }
    },
    "uiPush": {
      "type": "uiPush",
      "extensionId": "clipboard-history",
      "commandId": "open",
      "query": "par",
      "filterValue": "all",
      "tree": {
        "type": "list",
        "sections": [
          {
            "items": [
              {
                "id": "🎉",
                "title": "🎉 Party Popper",
                "subtitle": "celebration, party",
                "icon": "🎉",
                "actions": [
                  {
                    "id": "copy",
                    "title": "Copy",
                    "primary": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "nativeCall": {
      "type": "nativeCall",
      "requestId": "n-1",
      "extensionId": "emoji",
      "method": "clipboard.write",
      "params": {
        "text": "🎉"
      }
    },
    "nativeCallDenied": {
      "type": "nativeCall",
      "requestId": "n-2",
      "extensionId": "emoji",
      "method": "http.fetch",
      "params": {
        "url": "https://evil.example.com/api"
      }
    },
    "nativeCallStorage": {
      "type": "nativeCall",
      "requestId": "n-3",
      "extensionId": "demo-ext",
      "method": "storage.get",
      "params": {
        "key": "last-sync"
      }
    },
    "nativeCallOpenUrl": {
      "type": "nativeCall",
      "requestId": "n-4",
      "extensionId": "demo-ext",
      "method": "shell.openUrl",
      "params": {
        "url": "https://example.com/release"
      }
    },
    "nativeCallToast": {
      "type": "nativeCall",
      "requestId": "n-5",
      "extensionId": "demo-ext",
      "method": "toast.show",
      "params": {
        "title": "Saved",
        "message": "Note stored",
        "style": "success"
      }
    },
    "nativeCallAlert": {
      "type": "nativeCall",
      "requestId": "n-6",
      "extensionId": "demo-ext",
      "method": "alert.confirm",
      "params": {
        "title": "Delete note?",
        "message": "This cannot be undone.",
        "confirmTitle": "Delete",
        "destructive": true
      }
    },
    "log": {
      "type": "log",
      "level": "info",
      "message": "emoji catalog loaded (1878 items)"
    },
    "ack": {
      "type": "ack",
      "requestId": "a-2"
    },
    "windowCommand": {
      "type": "windowCommand",
      "extensionId": "demo-ext",
      "command": "closeMainWindow"
    },
    "launchCommand": {
      "type": "launchCommand",
      "extensionId": "demo-ext",
      "commandId": "open",
      "query": "notes"
    },
    "webView": {
      "type": "webView",
      "requestId": "s-9",
      "extensionId": "speedtest",
      "commandId": "test",
      "entry": "main.web.js",
      "props": {
        "query": "",
        "preferences": {
          "vaultPath": "C:/notes"
        },
        "environment": {
          "extensionId": "speedtest",
          "extensionName": "Speedtest",
          "extensionVersion": "0.1.0",
          "commandId": "test",
          "commandMode": "view",
          "isDevelopment": false
        }
      }
    },
    "webResult": {
      "type": "webResult",
      "bridgeId": "w-1",
      "ok": true,
      "result": {
        "status": 200,
        "headers": {},
        "bytesReceived": 4000000
      }
    }
  }
}
