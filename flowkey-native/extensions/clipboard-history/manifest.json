{
  "id": "clipboard-history",
  "name": "Clipboard History",
  "version": "2.0.0",
  "description": "Browse, preview and re-paste recent clipboard entries.",
  "icon": "📋",
  "commands": [
    {
      "id": "open",
      "title": "Clipboard History",
      "mode": "view",
      "ui": "web",
      "webEntry": "app.web.js",
      "keywords": ["clipboard", "history", "paste"],
      "icon": "clipboard",
      "iconColor": "#F59E0B"
    },
    {
      "id": "clear",
      "title": "Clear Clipboard History",
      "mode": "background",
      "keywords": ["clipboard", "clear", "wipe"],
      "icon": "trash-2",
      "iconColor": "#EF4444"
    }
  ],
  "nativeMethods": [
    "clipboard.read",
    "clipboard.history",
    "clipboard.clearHistory",
    "clipboard.write",
    "clipboard.deleteEntry",
    "clipboard.copyEntry",
    "clipboard.pasteEntry",
    "clipboard.editEntry",
    "hud.show"
  ],
  "httpHosts": [],
  "preferences": [
    {
      "name": "showTimestamps",
      "type": "checkbox",
      "title": "Show timestamps in results",
      "default": true
    }
  ]
}
