# OS / editor
.DS_Store
.idea/
*.swp
*.swo

# Workspace dependencies
node_modules/

# Only the workspace root lockfile is real; nested ones are stray artifacts of
# running install inside a package directory.
pnpm-lock.yaml
!/pnpm-lock.yaml

# flowkey-native is its own independent pnpm workspace; its lockfile is real.
!/flowkey-native/pnpm-lock.yaml

# .NET build artifacts (flowkey-native shell)
flowkey-native/**/bin/
flowkey-native/**/obj/
flowkey-native/shell/publish/
flowkey-native/**/TestResults/

# Local-only Claude config — never tracked, anywhere in the tree
.claude/
.superpowers/
docs/superpowers/

# Dogfood extensions live in their own repos; setup.mjs clones them here
/extensions/

# Browser companions live in their own repos; developed here, extracted later.
/browser-companions/

# Build artifacts (subpackages have their own .gitignore too — this is belt + suspenders)
dist/
build/
.svelte-kit/
target/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.*.local
.vscode/Asyar-Project.code-workspace
.agents/*
!.agents/skills/
!.agents/rules/

# Raycast reference screenshots (design gate only, never commit)
design-reference/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
