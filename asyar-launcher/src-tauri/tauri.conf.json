{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flowkey",
  "identifier": "org.asyar.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "flowkey",
        "width": 750,
        "height": 480,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": true,
        "center": true,
        "visible": false
      },
      {
        "label": "settings",
        "url": "/settings",
        "fullscreen": false,
        "resizable": true,
        "title": "Flowkey Settings",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "island",
        "url": "/island",
        "title": "Flowkey Island",
        "width": 420,
        "height": 64,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": false
      },
      {
        "label": "snap-guides",
        "url": "/snap-guides",
        "title": "Flowkey Snap Guides",
        "width": 1,
        "height": 1,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asyar-icon: http://asyar-icon.localhost asyar-extension: http://asyar-extension.localhost asyar-thumb: http://asyar-thumb.localhost asset: https://asset.localhost data: https://*; connect-src 'self' https://asyar.org http://localhost:* https://*; frame-src asyar-extension: http://asyar-extension.localhost blob:; font-src 'self'; object-src 'none'; base-uri 'self'",
      "capabilities": ["default", "island", "snap-guides"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["built-in-features", "resources/capabilitySpec"]
  },
  "plugins": {
    "fs": {},
    "http": null,
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNDUwMkFDNTdBOUQxMjUKUldRbDBhbFhyQUpGd3ArcUplOWtFTk1UV1I1QWIweGtCRU0zMTd5YjZZTXdJbi95Zm43aExZZk0K",
      "endpoints": ["https://asyar.org/api/update/{{target}}-{{arch}}/{{current_version}}"]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["asyar"]
      }
    }
  }
}
